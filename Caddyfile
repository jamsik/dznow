# Нужен только профилю caddy. Caddy сам получает и продлевает сертификат
# Let's Encrypt для APP_DOMAIN — отдельных команд для этого нет.
#
# Условие одно: домен должен указывать A-записью на этот сервер,
# а порты 80 и 443 должны быть свободны.

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8010
}
