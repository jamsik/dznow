# Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env в git не попадает — он в .gitignore.

# --- обязательное -----------------------------------------------------
# Токен нового бота из @BotFather. Он же выключает анонимный вход:
# пока токена нет, API пускает кого угодно, с токеном — проверяет подпись.
BOT_TOKEN=

# Адрес, по которому Telegram откроет приложение. Только https.
#   свой домен:      https://dznow.вашдомен.ru
#   через туннель:   адрес выдаёт сам туннель, см. tools/tunnel-url.sh
APP_URL=

# Имя бота без «собачки» — приложение покажет ссылку на него,
# если кто-то откроет адрес в обычном браузере.
BOT_USERNAME=

# --- нужно профилю caddy ----------------------------------------------
# Тот же домен, что в APP_URL, но без https:// и без хвоста.
APP_DOMAIN=

# --- по желанию -------------------------------------------------------
# Где app слушает на сервере. Менять, только если 8010 уже занят.
APP_BIND=127.0.0.1:8010

# Однократный перенос старого владельца шаблона в админку при обновлении.
# Новые назначения делаются через /dzadmin; после переноса можно оставить пустым.
SAMOLET_TEMPLATE_USER_ID=

# Админка /dzadmin. Укажите отдельный длинный пароль (минимум 12 символов)
# и случайный ключ сессии (минимум 32 символа). Пока они пусты, вход выключен.
DZADMIN_PASSWORD=
DZADMIN_SESSION_SECRET=

# Каталог с четырьмя CoFo Sans .woff2 для персонального макета.
# В Docker по умолчанию: /data/samolet-fonts (том dznow-data).
SAMOLET_FONT_DIR=
