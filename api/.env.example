# Токен бота — им же проверяется подпись initData из Mini App
BOT_TOKEN=

# Локальная разработка без Telegram: пускать анонимного пользователя.
# В проде обязательно 0.
ALLOW_DEV_NO_AUTH=1

# Где лежит собранный фронтенд для рендера (страница render.html).
# dev:  npm run dev      -> http://127.0.0.1:5173/render.html
# prod: npm run build && npm run preview -> http://127.0.0.1:4173/render.html
RENDER_URL=http://127.0.0.1:5173/render.html

# Куда складывать готовые файлы и базу
DATA_DIR=./data
API_HOST=127.0.0.1
API_PORT=8010
